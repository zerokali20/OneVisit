# ==========================================
# OneVisit Environment Configuration Template
# ==========================================

# Backend API Configuration
PROJECT_NAME="OneVisit API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL for Production / SQLite for zero-config local dev)
# Local SQLite fallback: sqlite:///onevisit.db
DATABASE_URL="sqlite:///onevisit.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://onevisit_user:onevisit_password@localhost:5432/onevisit_db"

# LLM & AI Provider Settings (Optional: Deterministic rule engine functions independently)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY=""

# Document Storage Limits
MAX_FILE_SIZE_MB=10

# Frontend Next.js Public Endpoint
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
